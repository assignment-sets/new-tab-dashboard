{
  "manifest_version": 3,
  "name": "New Tab",
  "description": "Tasks, pinned sites, and a local clock on your New Tab page.",
  "version": "1.1.0",
  "permissions": ["storage", "alarms", "offscreen"],
  "optional_permissions": ["notifications"],
  "host_permissions": ["https://api.open-meteo.com/*", "https://geocoding-api.open-meteo.com/*"],
  "icons": {
    "16": "icons/tasks-16.png",
    "32": "icons/tasks-32.png",
    "48": "icons/tasks-48.png",
    "128": "icons/tasks-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "new-tab.html"
  },
  "action": {
    "default_title": "New Tab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/tasks-16.png",
      "32": "icons/tasks-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
