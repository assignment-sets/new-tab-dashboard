{
  "manifest_version": 3,
  "name": "Tab Tasks",
  "description": "A simple, offline to-do list on your New Tab page and Chrome toolbar.",
  "version": "1.0.0",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/tasks-16.png",
    "32": "icons/tasks-32.png",
    "48": "icons/tasks-48.png",
    "128": "icons/tasks-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "new-tab.html"
  },
  "action": {
    "default_title": "Tab Tasks",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/tasks-16.png",
      "32": "icons/tasks-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
